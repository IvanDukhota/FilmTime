<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rounded_background"
    tools:context=".ProfileEditActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/pfpImageEdit"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/rounded_background_dark"
                app:srcCompat="@drawable/account" />

            <Button
                android:id="@+id/ButtonPfpEdit"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_button_border"
                android:backgroundTint="#AAB1BB"
                android:text="Upload new photo"
                android:textColor="@color/white"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/emailTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/rounded_background_dark"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white" />

        <EditText
            android:id="@+id/editTextUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/rounded_edittext_background"
            android:hint="Nickname"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white" />

        <EditText
            android:id="@+id/editTextPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/rounded_edittext_background"
            android:hint="Password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white" />

        <EditText
            android:id="@+id/editTextRepeatPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/rounded_edittext_background"
            android:hint="Repeat password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white" />

        <EditText
            android:id="@+id/editTextCountry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/rounded_edittext_background"
            android:hint="Country"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white" />

        <EditText
            android:id="@+id/editTextBio"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_edittext_background"
            android:gravity="top|start"
            android:hint="About Me"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white" />

        <LinearLayout
            android:id="@+id/preferences_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_background"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/preferences_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Preferences"
                android:textColor="@color/white"
                android:textSize="23dp" />

            <GridLayout
                android:id="@+id/preferences_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="4">

                <!-- Buttons for genres -->
                <Button
                    android:id="@+id/btn_romance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnSpan="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/button_background"
                    android:fontFamily="sans-serif"
                    android:paddingVertical="8dp"
                    android:text="Romance"
                    android:textSize="18dp"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btn_drama"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnSpan="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/button_background"
                    android:fontFamily="sans-serif"
                    android:paddingVertical="8dp"
                    android:text="Drama"
                    android:textSize="18dp"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btn_comedy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnSpan="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/button_background"
                    android:fontFamily="sans-serif"
                    android:paddingVertical="8dp"
                    android:text="Comedy"
                    android:textSize="18dp"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btn_action"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnSpan="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/button_background"
                    android:fontFamily="sans-serif"
                    android:paddingVertical="8dp"
                    android:text="Action"
                    android:textSize="18dp"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btn_thriller"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnSpan="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/button_background"
                    android:fontFamily="sans-serif"
                    android:paddingVertical="8dp"
                    android:text="Thriller"
                    android:textSize="18dp"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btn_fantasy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnSpan="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/button_background"
                    android:fontFamily="sans-serif"
                    android:paddingVertical="8dp"
                    android:text="Fantasy"
                    android:textSize="18dp"
                    android:textColor="@color/white" />
            </GridLayout>
        </LinearLayout>

        <!-- Buttons at the bottom -->
        <LinearLayout
            android:id="@+id/action_buttons_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonCancelEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:paddingVertical="8dp"
                android:text="Cancel"
                android:textSize="20dp"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/buttonSaveEdited"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:backgroundTint="#AAB1BB"
                android:paddingVertical="8dp"
                android:text="Edit"
                android:textSize="20dp"
                android:textColor="@color/white" />
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>